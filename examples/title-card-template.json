        {
          "property": "layer_duration",
          "layer": "panel"
        },
        {
          "property": "layer_duration",
          "layer": "label"
        }
      ]
    },
    {
      "name": "fade",
      "definition": {
        "type": "curve",
        "default": {
          "keys": [
            {
              "time": {
                "num": 0,
                "den": 1
              },
              "value": 0,
              "interpolation": "linear"
            },
            {
              "time": {
                "num": 1,
                "den": 5
              },
              "value": 255,
              "interpolation": "hold"
            },
            {
              "time": {
                "num": 14,
                "den": 5
              },
              "value": 255,
              "interpolation": "linear"
            },
            {
              "time": {
                "num": 3,
                "den": 1
              },
              "value": 0,
              "interpolation": "hold"
            }
          ]
        }
      },
      "bindings": [
        {
          "property": "opacity_curve",
          "layer": "panel"
        },
        {
          "property": "opacity_curve",
          "layer": "label"
        }
      ]
    },
    {
      "name": "rise",
      "definition": {
        "type": "curve",
        "default": {
          "keys": [
            {
              "time": {
                "num": 0,
                "den": 1
              },
              "value": 6,
              "interpolation": "ease_out"
            },
            {
              "time": {
                "num": 1,
                "den": 5
              },
              "value": 0,
              "interpolation": "hold"
            }
          ]
        }
      },
      "bindings": [
        {
          "property": "position_y_curve",
          "layer": "panel"
        },
        {
          "property": "position_y_curve",
          "layer": "label"
        }
      ]
    }
