            28,
            56,
            89,
            220
          ],
          "stroke": {
            "width": 1,
            "color": [
              64,
              184,
              211,
              255
            ]
          }
        },
        "timing": "strict",
        "end": "hold_last",
        "transform": {
          "position": [
            0,
            0
          ],
          "crop": [
            0,
            0,
            160,
            90
          ],
          "scale": 1,
          "quarter_turns": 0,
          "opacity": 255
        }
      },
      {
        "id": "label",
        "canvas": [
          160,
          90
        ],
        "start": {
          "num": 0,
          "den": 1
        },
        "duration": {
          "num": 3,
          "den": 1
        },
        "frames": [],
        "graphics": {
          "kind": "text",
          "text": "Title",
          "fonts": [],
          "size": 20,
          "color": [
            244,
            239,
            224,
            255
          ],
          "rect": [
            16,
            24,
            128,
            39
          ],
          "line_height": 24,
          "letter_spacing": 0,
          "align": "center",
          "wrap": "none",
          "overflow": "reject"
        },
        "timing": "strict",
        "end": "hold_last",
        "transform": {
          "position": [
            0,
            0
          ],
          "crop": [
            0,
            0,
            160,
            90
          ],
          "scale": 1,
          "quarter_turns": 0,
          "opacity": 255
