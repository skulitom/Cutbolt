          "property": "fonts",
          "layer": "label"
        }
      ]
    },
    {
      "name": "ink",
      "definition": {
        "type": "color",
        "default": [
          244,
          239,
          224,
          255
        ]
      },
      "bindings": [
        {
          "property": "text_color",
          "layer": "label"
        }
      ]
    },
    {
      "name": "panel",
      "definition": {
        "type": "color",
        "default": [
          28,
          56,
          89,
          220
        ]
      },
      "bindings": [
        {
          "property": "shape_fill",
          "layer": "panel"
        }
      ]
    },
    {
      "name": "font_size",
      "definition": {
        "type": "integer",
        "default": 20,
        "min": 8,
        "max": 28
      },
      "bindings": [
